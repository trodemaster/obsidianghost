{
  "name": "obsidian-claude-ghostty",
  "version": "0.9.0",
  "description": "Agent sidebar terminal for Obsidian — configurable startup commands + libghostty-vt (WebAssembly) renderer + node-pty + OSC 8 vault links",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.cjs",
    "build": "node esbuild.config.cjs --production",
    "test:vt": "node scripts/test-vt.mjs",
    "test:images": "node scripts/test-terminal.mjs kitty-images",
    "test:rendering": "node scripts/test-terminal.mjs rendering"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
