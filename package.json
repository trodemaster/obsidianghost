{
  "name": "obsidian-claude-ghostty",
  "version": "0.1.0",
  "description": "Agent sidebar terminal for Obsidian — configurable startup commands + libghostty-vt renderer + node-pty + OSC 8 vault links",
  "main": "main.js",
  "scripts": {
    "test:images": "node scripts/test-terminal.mjs kitty-images",
    "test:rendering": "node scripts/test-terminal.mjs rendering",
    "dev": "node esbuild.config.cjs",
    "build": "node esbuild.config.cjs --production"
  },
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "node-gyp": "^11.0.0",
    "obsidian": "^1.8.0",
    "typescript": "^5.8.0"
  }
}
